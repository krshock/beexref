# The AppImage build environment for tools/release/linux-appimage.sh:
# Ubuntu 20.04 (the glibc 2.31 floor from docs/linux-appimage.md),
# g++-10 for C++20, Kitware's CMake, Qt from aqtinstall (through a pinned
# Miniforge, because 20.04's Python 3.8 is too old for aqt), and pinned
# AppImage tools.
#
# Build it through the script, which passes WITH_WAYLAND when asked:
#
#   tools/release/linux-appimage.sh [--with-wayland]
FROM ubuntu:20.04

ARG WITH_WAYLAND=0
ARG QT_VERSION=6.8.3
ARG AQTINSTALL_VERSION=3.3.0
ARG MINIFORGE_VERSION=26.7.2-0
ARG MINIFORGE_SHA256=281b0ac7d550802efc81af633225a5e6116d29ae72f3ab4eae7168c3931a4c05
ARG LINUXDEPLOY_VERSION=1-alpha-20251107-1
ARG LINUXDEPLOY_SHA256=c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d
# The Qt plugin has no published checksum; it is pinned by release tag.
ARG LINUXDEPLOY_PLUGIN_QT_VERSION=1-alpha-20250213-1
# appimagetool only ships a rolling `continuous` tag; the checksum is not
# pinned because the tag moves.
ARG APPIMAGETOOL_VERSION=continuous

ENV DEBIAN_FRONTEND=noninteractive

# The build toolchain, the X libraries Qt needs, and the AppImage tools'
# own dependencies (docs/linux-appimage.md lists the same set).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential g++-10 ninja-build git wget ca-certificates \
        pkg-config ccache python3 python3-venv \
        libgl1 libxkbcommon0 libxkbcommon-x11-0 libfontconfig1 libfreetype6 \
        libdbus-1-3 libglib2.0-0 \
        libx11-xcb1 libxcb1 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-sync1 \
        libxcb-xfixes0 libxcb-xkb1 \
        libwayland-client0 libwayland-cursor0 libwayland-egl1 \
        libfuse2 patchelf file desktop-file-utils xvfb zip unzip \
    && rm -rf /var/lib/apt/lists/*

# The xcb platform plugin needs libxcb-cursor0, which is not in focal;
# the 22.04 package's dependencies all are.
RUN wget -q -O /tmp/libxcb-cursor0.deb \
        http://archive.ubuntu.com/ubuntu/pool/universe/x/xcb-util-cursor/libxcb-cursor0_0.1.1-4ubuntu1_amd64.deb \
    && apt-get update && apt-get install -y --no-install-recommends /tmp/libxcb-cursor0.deb \
    && rm -f /tmp/libxcb-cursor0.deb && rm -rf /var/lib/apt/lists/*

# Kitware's CMake: 20.04 ships 3.16, the project needs 3.24.
RUN wget -q -O - https://apt.kitware.com/keys/kitware-archive-latest.asc 2>/dev/null \
        | gpg --dearmor - > /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo 'deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ focal main' \
        > /etc/apt/sources.list.d/kitware.list \
    && apt-get update && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*

# Qt through aqtinstall, on a pinned Miniforge Python (3.8 is too old
# for aqt 3.3, which 6.8.3 needs).
RUN wget -q -O /tmp/miniforge.sh \
        "https://github.com/conda-forge/miniforge/releases/download/${MINIFORGE_VERSION}/Miniforge3-${MINIFORGE_VERSION}-Linux-x86_64.sh" \
    && echo "${MINIFORGE_SHA256}  /tmp/miniforge.sh" | sha256sum -c - \
    && bash /tmp/miniforge.sh -b -p /opt/miniforge \
    && rm -f /tmp/miniforge.sh \
    && /opt/miniforge/bin/pip install --no-cache-dir "aqtinstall==${AQTINSTALL_VERSION}" \
    && if [ "$WITH_WAYLAND" = "1" ]; then \
           /opt/miniforge/bin/aqt install-qt --outputdir /opt/Qt \
               linux desktop "$QT_VERSION" linux_gcc_64 -m qtimageformats qtwayland; \
       else \
           /opt/miniforge/bin/aqt install-qt --outputdir /opt/Qt \
               linux desktop "$QT_VERSION" linux_gcc_64 -m qtimageformats; \
       fi

RUN mkdir -p /opt/appimage-tools && cd /opt/appimage-tools \
    && wget -q -O linuxdeploy-x86_64.AppImage \
        "https://github.com/linuxdeploy/linuxdeploy/releases/download/${LINUXDEPLOY_VERSION}/linuxdeploy-x86_64.AppImage" \
    && echo "${LINUXDEPLOY_SHA256}  linuxdeploy-x86_64.AppImage" | sha256sum -c - \
    && wget -q -O linuxdeploy-plugin-qt-x86_64.AppImage \
        "https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/${LINUXDEPLOY_PLUGIN_QT_VERSION}/linuxdeploy-plugin-qt-x86_64.AppImage" \
    && wget -q -O appimagetool-x86_64.AppImage \
        "https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOL_VERSION}/appimagetool-x86_64.AppImage" \
    && chmod +x *.AppImage

ENV QT_DIR=/opt/Qt/${QT_VERSION}/gcc_64 \
    APPIMAGE_TOOLS=/opt/appimage-tools \
    APPIMAGE_EXTRACT_AND_RUN=1 \
    CCACHE_DIR=/tmp/ccache
